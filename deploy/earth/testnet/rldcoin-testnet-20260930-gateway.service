[Unit]
Description=Rldcoin worthless fresh testnet gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=galaxy
UMask=0077
WorkingDirectory=/home/galaxy/rldcoin-testnet-20260930
ExecStart=/home/galaxy/rldcoin-testnet-20260930/bin/rld-testnet-run gateway
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/galaxy/rldcoin-testnet-20260930
MemoryMax=512M
CPUQuota=50%
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
