[Unit]
Description=Rldcoin worthless fresh testnet source
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=galaxy
UMask=0077
WorkingDirectory=/home/galaxy/rldcoin-testnet-20260930
ExecStart=/home/galaxy/rldcoin-testnet-20260930/bin/rld-testnet-run run --root /home/galaxy/rldcoin-testnet-20260930 --mode source --expected-implementation d4fdaf6dbb05d00e1820f585dc7ddeb5f0d10f927b003d4551c0429a92d66b54
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/galaxy/rldcoin-testnet-20260930
MemoryMax=512M
CPUQuota=50%
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
